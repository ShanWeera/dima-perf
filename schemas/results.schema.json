{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanweera.github.io/dima-perf/schemas/1.0/results.schema.json",
  "title": "DiMA results",
  "description": "Results of `dima analyze` (DiMA: Tharanga et al. 2025, Brief Bioinform 26(1):bbae607, doi:10.1093/bib/bbae607). Keys follow DiMA; undefined or not computed values are null.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "query_name": {
      "type": "string"
    },
    "sequence_count": {
      "type": "integer",
      "minimum": 0
    },
    "support_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "kmer_length": {
      "type": "integer",
      "minimum": 1
    },
    "low_support_count": {
      "description": "Positions with support ≤ T (NS + LS + ELS).",
      "type": "integer",
      "minimum": 0
    },
    "average_entropy": {
      "description": "Mean entropy over eligible positions (support > T).",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "lowest_entropy": {
      "anyOf": [
        {
          "$ref": "#/$defs/extremum"
        },
        {
          "type": "null"
        }
      ]
    },
    "highest_entropy": {
      "anyOf": [
        {
          "$ref": "#/$defs/extremum"
        },
        {
          "type": "null"
        }
      ]
    },
    "position_count": {
      "description": "Alignment length − k + 1.",
      "type": "integer",
      "minimum": 0
    },
    "eligible_position_count": {
      "type": "integer",
      "minimum": 0
    },
    "support_label_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NS": {
          "type": "integer",
          "minimum": 0
        },
        "LS": {
          "type": "integer",
          "minimum": 0
        },
        "ELS": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "NS",
        "LS",
        "ELS",
        "eligible"
      ]
    },
    "all_positions_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string"
        },
        "position_count": {
          "type": "integer",
          "minimum": 0
        },
        "average_entropy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lowest_entropy": {
          "anyOf": [
            {
              "$ref": "#/$defs/extremum"
            },
            {
              "type": "null"
            }
          ]
        },
        "highest_entropy": {
          "anyOf": [
            {
              "$ref": "#/$defs/extremum"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rule",
        "position_count",
        "average_entropy",
        "lowest_entropy",
        "highest_entropy"
      ],
      "description": "Summary with DiMA v5.0.9's averaging rule."
    },
    "coverage_summary": {
      "description": "Sample coverage over every position with support of at least 2, eligible and low-support (LS, ELS) positions alike.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluated": {
          "description": "Positions with a sample coverage (support of at least 2).",
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "description": "Lowest sample coverage of the evaluated positions; null when no position is evaluated.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mean": {
          "description": "Mean sample coverage of the evaluated positions; null when no position is evaluated.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "min_coverage": {
          "description": "--min-coverage; null when it was not given.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "below_min_count": {
          "description": "Evaluated positions with a sample coverage below min_coverage; null when --min-coverage was not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "evaluated",
        "min",
        "mean",
        "min_coverage",
        "below_min_count"
      ]
    },
    "similarity_weighted_entropy_summary": {
      "description": "Similarity-weighted entropy over eligible positions (support > T), with the mean observed entropy of the same positions (Wu 2025); null when not requested.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position_count": {
              "type": "integer",
              "minimum": 0
            },
            "average_entropy": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "lowest_entropy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/extremum"
                },
                {
                  "type": "null"
                }
              ]
            },
            "highest_entropy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/extremum"
                },
                {
                  "type": "null"
                }
              ]
            },
            "average_observed_entropy": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "position_count",
            "average_entropy",
            "lowest_entropy",
            "highest_entropy",
            "average_observed_entropy"
          ]
        }
      ]
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "required": [
    "schema_version",
    "query_name",
    "sequence_count",
    "support_threshold",
    "kmer_length",
    "low_support_count",
    "average_entropy",
    "lowest_entropy",
    "highest_entropy",
    "position_count",
    "eligible_position_count",
    "support_label_counts",
    "all_positions_summary",
    "coverage_summary",
    "similarity_weighted_entropy_summary",
    "run",
    "results"
  ],
  "allOf": [
    {
      "description": "Presence rules of every 1.x results file: the similarity-weighted values and their summary are given exactly where the run computed them.",
      "if": {
        "properties": {
          "run": {
            "properties": {
              "parameters": {
                "properties": {
                  "similarity_weighted_entropy": {
                    "properties": {
                      "value": {
                        "const": true
                      }
                    },
                    "required": [
                      "value"
                    ]
                  }
                },
                "required": [
                  "similarity_weighted_entropy"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "run"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/$defs/swe_on"
            }
          },
          "similarity_weighted_entropy_summary": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/$defs/swe_off"
            }
          },
          "similarity_weighted_entropy_summary": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "origin": {
      "description": "Where a parameter's value came from.",
      "enum": [
        "default",
        "user",
        "derived"
      ]
    },
    "alphabet": {
      "enum": [
        "protein",
        "dna",
        "rna"
      ]
    },
    "estimator": {
      "enum": [
        "dima",
        "chao_wang_jost",
        "miller_madow",
        "raw"
      ]
    },
    "validation_mode": {
      "enum": [
        "strict",
        "permissive",
        "report"
      ]
    },
    "extremum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "description": "1-based position of the first position with this value.",
          "type": "integer",
          "minimum": 1
        },
        "entropy": {
          "description": "Entropy in bits.",
          "type": "number",
          "minimum": 0
        },
        "tied_position_count": {
          "description": "Number of positions with exactly this value.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "position",
        "entropy",
        "tied_position_count"
      ],
      "description": "An entropy extremum."
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sha-256"
        },
        "value": {
          "description": "Lower-case hexadecimal digest.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "dima"
        },
        "version": {
          "description": "SemVer version.",
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable diagnostic code.",
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "severity": {
          "enum": [
            "info",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "count": {
          "description": "Number of occurrences.",
          "type": "integer",
          "minimum": 0
        },
        "examples": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          },
          "description": "The first occurrences, in input order."
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "count",
        "examples",
        "hint"
      ],
      "description": "A condition worth knowing about (it did not stop the analysis)."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "citation": {
          "description": "Full reference text.",
          "type": "string"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\."
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      },
      "required": [
        "key",
        "citation",
        "doi",
        "url"
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "description": "The k-mer, upper case.",
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "count": {
          "description": "Sequences carrying it.",
          "type": "integer",
          "minimum": 1
        },
        "incidence": {
          "description": "count / support × 100.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "motif_short": {
          "enum": [
            "I",
            "Ma",
            "Mi",
            "U"
          ]
        },
        "motif_long": {
          "enum": [
            "Index",
            "Major",
            "Minor",
            "Unique"
          ]
        },
        "metadata": {
          "description": "Header-field value counts, in header-format order, values sorted; null without a header format.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "required": [
        "sequence",
        "count",
        "incidence",
        "motif_short",
        "motif_long",
        "metadata"
      ],
      "description": "A distinct k-mer at a position."
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "description": "1-based alignment column of the k-mer's first residue.",
          "type": "integer",
          "minimum": 1
        },
        "low_support": {
          "description": "NS (support 0), LS (0 < support < T), ELS (support = T), null when eligible (support > T).",
          "enum": [
            "NS",
            "LS",
            "ELS",
            null
          ]
        },
        "support": {
          "description": "Sequences with a valid k-mer here (N).",
          "type": "integer",
          "minimum": 0
        },
        "distinct_variants_count": {
          "description": "Distinct non-Index variants.",
          "type": "integer",
          "minimum": 0
        },
        "entropy": {
          "description": "Entropy in bits from entropy_method; null without support.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "observed_entropy": {
          "description": "Plug-in (observed) entropy in bits; null without support (NS).",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "entropy_method": {
          "description": "The method that produced entropy: dima (the paper's correction), chao_wang_jost, miller_madow, plug_in (the observed entropy: estimator raw, or a fallback named by entropy_fallback) or not_estimable (no support).",
          "enum": [
            "dima",
            "chao_wang_jost",
            "miller_madow",
            "plug_in",
            "not_estimable"
          ]
        },
        "entropy_fallback": {
          "description": "Why the requested estimator was not used: support_at_or_below_threshold (support ≤ T), too_few_points (support below 1.25 × T, rounded up: fewer than five regression points) or degenerate_regression (T = 2, support 3: equal subsample sizes) for dima; single_observation (support 1) for chao_wang_jost and miller_madow. Null when the estimator was used, with estimator raw, and without support.",
          "enum": [
            "support_at_or_below_threshold",
            "too_few_points",
            "degenerate_regression",
            "single_observation",
            null
          ]
        },
        "distinct_variants_incidence": {
          "description": "Non-Index variant types per 100 non-Index sequences.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "total_variants_incidence": {
          "description": "Non-Index sequences per 100 supporting sequences.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "sample_coverage": {
          "description": "Estimated sample coverage (Chao & Jost 2012), the probability that one more sequence carries a k-mer already seen here; null when support is below 2.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "below_min_coverage": {
          "description": "Whether sample_coverage is below --min-coverage; null without the option, and where sample_coverage is null.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "similarity_weighted_entropy": {
          "description": "Similarity-weighted entropy H_sim in bits (Wu 2025); null when not requested or without support.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "normalised_observed_entropy": {
          "description": "Observed entropy divided by log2 of the number of distinct k-mers, Index included (H_n, Wu 2025); null when not requested or with fewer than two distinct k-mers.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "normalised_similarity_weighted_entropy": {
          "description": "Similarity-weighted entropy divided by log2 of the number of distinct k-mers (H_nsim, Wu 2025); null when not requested or with fewer than two distinct k-mers.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "diversity_motifs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      },
      "required": [
        "position",
        "low_support",
        "support",
        "distinct_variants_count",
        "entropy",
        "observed_entropy",
        "entropy_method",
        "entropy_fallback",
        "distinct_variants_incidence",
        "total_variants_incidence",
        "sample_coverage",
        "below_min_coverage",
        "similarity_weighted_entropy",
        "normalised_observed_entropy",
        "normalised_similarity_weighted_entropy",
        "diversity_motifs"
      ],
      "description": "Results for one k-mer position."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alphabet": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "$ref": "#/$defs/alphabet"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Sequence alphabet."
            },
            "kmer_length": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "k-mer length."
            },
            "support_threshold": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Support threshold T."
            },
            "estimator": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "$ref": "#/$defs/estimator"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Entropy estimator."
            },
            "similarity_weighted_entropy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Whether similarity-weighted entropy was computed (--similarity-weighted-entropy)."
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "$ref": "#/$defs/validation_mode"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Validation mode."
            },
            "min_coverage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Minimum sample coverage."
            },
            "query_name": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Query name."
            },
            "header_format": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Header field names."
            },
            "metadata_fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Stratified header fields."
            },
            "header_fill": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": [
                "value",
                "origin"
              ],
              "description": "Fill value."
            }
          },
          "required": [
            "alphabet",
            "kmer_length",
            "support_threshold",
            "estimator",
            "similarity_weighted_entropy",
            "validation",
            "min_coverage",
            "query_name",
            "header_format",
            "metadata_fields",
            "header_fill"
          ]
        },
        "alphabet": {
          "description": "The alphabet decision.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resolved": {
              "description": "The alphabet used.",
              "$ref": "#/$defs/alphabet"
            },
            "method": {
              "description": "detected (from the letters of the first records, with the rules of esl_abc_GuessAlphabet in Easel, the sequence library of HMMER) or user (--alphabet).",
              "enum": [
                "detected",
                "user"
              ]
            },
            "records_examined": {
              "description": "Records of the first batch, whose letters detection examines: at most 10,000 records or 64 MiB, and at least the first 1,000 records (or all, if there are fewer). Recorded also when the alphabet was given.",
              "type": "integer",
              "minimum": 0
            },
            "residues_examined": {
              "description": "Letters A–Z, in either case, in those records: ambiguity codes and letters outside the alphabet included.",
              "type": "integer",
              "minimum": 0
            },
            "t_u_folded": {
              "description": "U letters read as T (DNA) or T letters read as U (RNA), in the whole input.",
              "type": "integer",
              "minimum": 0
            },
            "contradiction": {
              "description": "Why the residue composition contradicts an explicit --alphabet; null when it does not, and when the alphabet was detected.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "resolved",
            "method",
            "records_examined",
            "residues_examined",
            "t_u_folded",
            "contradiction"
          ]
        },
        "alignment_length": {
          "description": "Alignment columns.",
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "File name without directories, or '-'.",
              "type": "string"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "checksum": {
              "$ref": "#/$defs/checksum"
            },
            "compression": {
              "enum": [
                "none",
                "gzip",
                "bzip2",
                "zstd"
              ]
            }
          },
          "required": [
            "name",
            "size_bytes",
            "checksum",
            "compression"
          ]
        },
        "validation": {
          "description": "What reading the input found.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "The validation mode.",
              "$ref": "#/$defs/validation_mode"
            },
            "records": {
              "description": "Records read.",
              "type": "integer",
              "minimum": 0
            },
            "lowercase_folded": {
              "description": "Lower-case letters read as upper case.",
              "type": "integer",
              "minimum": 0
            },
            "whitespace": {
              "description": "Sequence lines with white space.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "trailing": {
                  "description": "Sequence lines that end in white space.",
                  "type": "integer",
                  "minimum": 0
                },
                "interior": {
                  "description": "Sequence lines with white space between residues (ignored).",
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "trailing",
                "interior"
              ]
            },
            "characters": {
              "description": "Every byte value found in sequence lines (line endings excluded), one entry per byte value in byte order, so A and a are separate entries.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "char": {
                    "description": "The character when the byte is a visible ASCII character; null otherwise (space, tab and other control bytes, non-ASCII bytes).",
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1
                  },
                  "byte": {
                    "description": "The byte value, 0–255.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "class": {
                    "description": "Its symbol class in the alphabet used.",
                    "enum": [
                      "residue",
                      "gap",
                      "missing",
                      "ambiguity",
                      "stop",
                      "frameshift",
                      "whitespace",
                      "unknown"
                    ]
                  },
                  "count": {
                    "description": "Occurrences.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "char",
                  "byte",
                  "class",
                  "count"
                ]
              }
            },
            "unknown_total": {
              "description": "Characters of class unknown, whose k-mers were excluded (permissive and report modes); 0 in strict mode, which stops at the first.",
              "type": "integer",
              "minimum": 0
            },
            "header_utf8_replacements": {
              "description": "Invalid UTF-8 sequences in headers replaced by U+FFFD (permissive and report modes); 0 without --header-format, whose headers are not checked.",
              "type": "integer",
              "minimum": 0
            },
            "header_cleaning": {
              "description": "What cleaning changed in the values of stratified header fields; null without --header-format.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "unicode_version": {
                  "description": "Version of the Unicode tables used for NFC normalisation; another version can clean some values differently.",
                  "type": "string"
                },
                "trimmed": {
                  "description": "Values whose leading or trailing white space was removed.",
                  "type": "integer",
                  "minimum": 0
                },
                "invisible_removed": {
                  "description": "Invisible characters removed, by code point.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "code_point": {
                        "description": "The code point, U+XXXX.",
                        "type": "string",
                        "pattern": "^U\\+[0-9A-F]{4,6}$"
                      },
                      "count": {
                        "description": "Occurrences removed.",
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "code_point",
                      "count"
                    ]
                  }
                },
                "nfc_changed": {
                  "description": "Values changed by NFC normalisation.",
                  "type": "integer",
                  "minimum": 0
                },
                "fill_uses": {
                  "description": "Values replaced by the fill value, as run.metadata.fill_uses.",
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "unicode_version",
                "trimmed",
                "invisible_removed",
                "nfc_changed",
                "fill_uses"
              ]
            }
          },
          "required": [
            "mode",
            "records",
            "lowercase_folded",
            "whitespace",
            "characters",
            "unknown_total",
            "header_utf8_replacements",
            "header_cleaning"
          ]
        },
        "metadata": {
          "description": "Header metadata; null without --header-format.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "fields": {
              "description": "Every field name of --header-format, in order, trimmed and NFC-normalised.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stratified": {
              "description": "The stratified fields (--metadata-fields, or every field), in header-format order.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "probe_records": {
              "description": "Records of the first batch (as run.alphabet.records_examined), whose headers the identifier-like check examines; identifier_like_field needs at least 100.",
              "type": "integer",
              "minimum": 0
            },
            "mismatches": {
              "description": "Headers whose number of |-separated fields differs from --header-format.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "count": {
                  "description": "How many.",
                  "type": "integer",
                  "minimum": 0
                },
                "first": {
                  "description": "The first 20 of them, in input order.",
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "record": {
                        "description": "Record number, from 1.",
                        "type": "integer",
                        "minimum": 1
                      },
                      "line": {
                        "description": "Line of the header, from 1.",
                        "type": "integer",
                        "minimum": 1
                      },
                      "header": {
                        "description": "The header, without the leading >.",
                        "type": "string"
                      },
                      "expected": {
                        "description": "Fields of --header-format.",
                        "type": "integer",
                        "minimum": 0
                      },
                      "found": {
                        "description": "Fields of this header.",
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "record",
                      "line",
                      "header",
                      "expected",
                      "found"
                    ]
                  }
                }
              },
              "required": [
                "count",
                "first"
              ]
            },
            "fill_uses": {
              "description": "Stratified values replaced by the fill value: empty values and, in permissive mode, every stratified field of a header with the wrong number of fields.",
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "fields",
            "stratified",
            "probe_records",
            "mismatches",
            "fill_uses"
          ]
        },
        "entropy": {
          "description": "Entropy settings of the run.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "estimator": {
              "description": "The estimator, spelled with underscores (chao_wang_jost, miller_madow).",
              "$ref": "#/$defs/estimator"
            },
            "log_base": {
              "description": "Entropies are in bits.",
              "const": 2
            },
            "rarefaction": {
              "description": "The constants of the paper's correction (Fig. 2) with the dima estimator; null with the others.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "grid": {
                  "description": "Subsample percentages from the start to 95 in steps of 5 (the step of DiMA v5.0.9), plus 100%, the full data set.",
                  "const": "paper_fig2"
                },
                "size_rounding": {
                  "description": "A subsample of R% of N sequences has R·N/100 sequences, rounded up.",
                  "const": "ceil"
                },
                "start_rounding": {
                  "description": "The grid starts at 100·T/N rounded up to a whole number and then to a multiple of 5, and at 50 at least.",
                  "const": "ceil_to_5"
                },
                "sampling": {
                  "description": "The intercept is the exact average over all with-replacement subsamples, not one random draw.",
                  "const": "expected_with_replacement"
                },
                "min_points": {
                  "description": "With fewer regression points (support below 1.25 × T, rounded up) a position keeps its observed entropy (too_few_points); DiMA v5.0.9's minimum, which the paper does not state.",
                  "const": 5
                }
              },
              "required": [
                "grid",
                "size_rounding",
                "start_rounding",
                "sampling",
                "min_points"
              ]
            }
          },
          "required": [
            "estimator",
            "log_base",
            "rarefaction"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "tool",
        "parameters",
        "alphabet",
        "alignment_length",
        "input",
        "validation",
        "metadata",
        "entropy",
        "diagnostics",
        "references"
      ],
      "description": "Deterministic provenance of the run."
    },
    "swe_off": {
      "description": "A position of a run without similarity-weighted entropy: its three values are null.",
      "properties": {
        "similarity_weighted_entropy": {
          "type": "null"
        },
        "normalised_observed_entropy": {
          "type": "null"
        },
        "normalised_similarity_weighted_entropy": {
          "type": "null"
        }
      }
    },
    "swe_on": {
      "description": "A position of a run with similarity-weighted entropy: the value is given wherever there is support, the normalised values wherever there are at least two distinct k-mers.",
      "allOf": [
        {
          "if": {
            "properties": {
              "support": {
                "minimum": 1
              }
            }
          },
          "then": {
            "properties": {
              "similarity_weighted_entropy": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "similarity_weighted_entropy": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "diversity_motifs": {
                "minItems": 2
              }
            }
          },
          "then": {
            "properties": {
              "normalised_observed_entropy": {
                "type": "number"
              },
              "normalised_similarity_weighted_entropy": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "normalised_observed_entropy": {
                "type": "null"
              },
              "normalised_similarity_weighted_entropy": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
